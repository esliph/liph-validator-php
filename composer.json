{
  "name": "esliph/validator",
  "description": "Uma biblioteca de validação de dados inspirada no Zod para PHP",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "validation",
    "schema",
    "validator"
  ],
  "authors": [
    {
      "name": "Dan Ruan",
      "email": "danrsaquetti@gmail.com"
    }
  ],
  "scripts": {
    "test": "vendor/bin/phpunit",
    "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
    "test:coverage": "php -d pcov.enabled=1 vendor/bin/phpunit --coverage-text",
    "test:coverage:html": "php -d pcov.enabled=1 vendor/bin/phpunit --coverage-html cache/tests/coverage --coverage-text"
  },
  "autoload": {
    "psr-4": {
      "Esliph\\Validator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Esliph\\Validator\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.3"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
