			path: src/Schemas/Schema.php

		-
			message: '#^PHPDoc tag @var has invalid value \(Closure\(mixed\)\[\]\)\: Unexpected token "\(", expected TOKEN_HORIZONTAL_WS at offset 16 on line 1$#'
			identifier: phpDoc.parseError
			count: 1
			path: src/Schemas/Schema.php

		-
			message: '#^Property Esliph\\Validator\\Schemas\\Schema\:\:\$transforms type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
